# ===========================================
# Boxeapp - Variáveis de ambiente
# Copie para .env.local (dev) ou configure no Portainer/VPS (prod).
# ===========================================

# --- Banco de dados ---
# Dev (Docker): postgresql://boxeapp:boxeapp@localhost:5432/boxeapp
# Prod: URL do Postgres já instalado no servidor
DATABASE_URL=postgresql://postgres:docker@localhost:5432/boxeapp

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=kajdfkjwuesadfjwekadflkjweafk

# --- Jobs (cron) ---
# Usado para proteger as rotas /api/cron/* (GitHub Actions ou node-cron)
CRON_SECRET=kajdfkjwuesadfjwekadflkjweafk13548

# --- Produção (Docker / GitHub Actions) ---
# Definir no repositório (Settings > Variables) ou no servidor:
# REGISTRY=ghcr.io
# IMAGE_NAME=owner/boxeapp
# IMAGE_TAG=latest
# TRAEFIK_HOST=app.seudominio.com
# VPS_HOST=ip-ou-dominio-vps
# VPS_USER=usuario-ssh
# DEPLOY_PATH=/caminho/no/servidor (onde ficam os compose e onde rodar stack deploy)
# SSH_PRIVATE_KEY = chave privada SSH (Settings > Secrets)

# --- Timezone (opcional; padrão nos jobs: America/Sao_Paulo) ---
TZ=America/Sao_Paulo
